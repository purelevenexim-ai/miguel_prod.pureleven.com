# ═══════════════════════════════════════════════════════════════════════
# ENVIRONMENT CONFIGURATION TEMPLATE
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub — always use .env.example for the template

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://miguel_user:your_db_password@db:5432/miguel_db
POSTGRES_PASSWORD=your_db_password

# ─── Environment ──────────────────────────────────────────────────────
ENV=development
# Options: development, uat, production

# ─── WhatsApp Business API ────────────────────────────────────────────
# Get these from Meta Developer Console → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_API_VERSION=v19.0
WHATSAPP_AUTO_REPLY_MSG=Hi! Thank you for reaching out. Our team will get back to you shortly. 😊

# ─── Meta Webhook Verification ───────────────────────────────────────
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ─── Encryption Key (for sensitive shipping configs) ──────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your_encryption_key_here

# ─── Delhivery API ───────────────────────────────────────────────────
# Get these from Delhivery → Account Settings → API Credentials
DELHIVERY_API_KEY=your_delhivery_api_key
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_ACCOUNT_ID=your_delhivery_account_id
DELHIVERY_BASE_URL=https://api.delhivery.com
# For sandbox/testing:
# DELHIVERY_BASE_URL=https://staging-api.delhivery.com

# ─── Shopify Integration ──────────────────────────────────────────────
# Get these from Shopify Admin → Settings → Apps and Integrations
SHOPIFY_STORE_NAME=your_shopify_store_name
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# ─── Email Configuration ──────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@yourcompany.com

# ─── WABIS (WhatsApp Bot Integration) ──────────────────────────────
WABIS_API_KEY=your_wabis_api_key
WABIS_PHONE_NUMBER_ID=your_wabis_phone_number_id
WABIS_ACCESS_TOKEN=your_wabis_access_token

# ─── AWS S3 (if using for file uploads) ───────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# ─── JWT Secret ────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─── GST Configuration (India) ───────────────────────────────────────
GST_API_KEY=your_gst_api_key
GST_STATE=your_state_code  # e.g. DL for Delhi

# ─── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
