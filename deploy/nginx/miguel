server {
    listen 80;
    server_name _;

    root /opt/miguel/frontend;
    index index.html;

    # ── Static HTML pages ────────────────────────────────────
    location / {
        try_files $uri $uri/ =404;
    }

    # ── Prevent browser caching of HTML pages ────────────────
    location ~* \.html$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files $uri =404;
    }

    # ── Backend API: business modules ────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:8000/api/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── Backend API: platform (superadmin) routes ─────────────
    location /platform/ {
        proxy_pass         http://127.0.0.1:8000/platform/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── Backend API: tenant (employee) routes ─────────────────
    location /tenant/ {
        proxy_pass         http://127.0.0.1:8000/tenant/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
